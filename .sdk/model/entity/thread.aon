    }
    {
      name: "tn_w"
      req: false
      short: "Thumbnail width"
      type: "`$INTEGER`"
    }
    {
      name: "trip"
      req: false
      short: "Tripcode"
      type: "`$STRING`"
    }
    {
      name: "unique_ips"
      req: false
      short: "Number of unique poster IPs"
