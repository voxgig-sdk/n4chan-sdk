# Entity: thread

main: kit: entity: thread: {

  alias: field: {}

  fields: [
    {
      name: "archived"
      req: false
      short: "Archived flag"
      type: "`$INTEGER`"
    }
    {
      name: "archived_on"
      req: false
      short: "Unix timestamp when archived"
      type: "`$INTEGER`"
    }
    {
      name: "bumplimit"
      req: false
      short: "Bump limit reached flag"
      type: "`$INTEGER`"
    }
    {
      name: "capcode"
      req: false
      short: "Capcode (mod, admin, etc.)"
      type: "`$STRING`"
    }
    {
      name: "closed"
      req: false
      short: "Closed flag"
      type: "`$INTEGER`"
    }
    {
      name: "com"
      req: false
      short: "Comment (HTML escaped)"
      type: "`$STRING`"
    }
    {
      name: "country"
      req: false
      short: "Country code"
      type: "`$STRING`"
    }
    {
      name: "country_name"
      req: false
      short: "Country name"
      type: "`$STRING`"
    }
    {
