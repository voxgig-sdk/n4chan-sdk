      short: "File extension"
      type: "`$STRING`"
    }
    {
      name: "filedeleted"
      req: false
      short: "File deleted flag"
      type: "`$INTEGER`"
    }
    {
      name: "filename"
      req: false
      short: "Original filename"
      type: "`$STRING`"
    }
    {
      name: "fsize"
      req: false
      short: "File size in bytes"
      type: "`$INTEGER`"
    }
    {
      name: "h"
      req: false
      short: "Image height"
      type: "`$INTEGER`"
    }
    {
      name: "id"
      req: false
      short: "Poster ID"
      type: "`$STRING`"
    }
    {
      name: "imagelimit"
      req: false
      short: "Image limit reached flag"
      type: "`$INTEGER`"
    }
    {
      name: "images"
      req: false
      short: "Number of images"
      type: "`$INTEGER`"
    }
    {
      name: "last_modified"
      req: false
      short: "Unix timestamp of last modification"
      type: "`$INTEGER`"
    }
    {
      name: "m_img"
      req: false
      short: "Mobile optimized image flag"
      type: "`$INTEGER`"
    }
    {
      name: "md5"
      req: false
      short: "MD5 hash in base64"
      type: "`$STRING`"
    }
    {
      name: "name"
      req: false
      short: "Poster name"
      type: "`$STRING`"
    }
    {
      name: "no"
      req: true
      short: "Post number"
      type: "`$INTEGER`"
    }
    {
      name: "now"
      req: true
      short: "Formatted date and time"
      type: "`$STRING`"
    }
    {
      name: "omitted_images"
      req: false
      short: "Number of omitted images"
      type: "`$INTEGER`"
    }
    {
      name: "omitted_posts"
      req: false
      short: "Number of omitted posts"
      type: "`$INTEGER`"
    }
    {
      name: "page"
      req: false
      short: "Page number"
      type: "`$INTEGER`"
    }
    {
      name: "replies"
      req: false
      short: "Number of replies"
      type: "`$INTEGER`"
    }
    {
      name: "resto"
      req: false
      short: "Reply to thread ID (0 for OP)"
      type: "`$INTEGER`"
    }
    {
      name: "semantic_url"
      req: false
      short: "SEO-friendly URL slug"
      type: "`$STRING`"
    }
    {
      name: "since4pass"
      req: false
      short: "Year 4chan pass purchased"
