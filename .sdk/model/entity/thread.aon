    }
    {
      name: "spoiler"
      req: false
      short: "Spoiler flag"
      type: "`$INTEGER`"
    }
    {
      name: "sticky"
      req: false
      short: "Sticky flag"
      type: "`$INTEGER`"
    }
    {
      name: "sub"
      req: false
      short: "Subject"
      type: "`$STRING`"
    }
    {
      name: "tag"
      req: false
      short: "Tag"
      type: "`$STRING`"
    }
    {
      name: "threads"
      req: false
      type: "`$ARRAY`"
    }
    {
      name: "tim"
      req: false
      short: "Unix timestamp for image"
      type: "`$INTEGER`"
    }
    {
      name: "time"
      req: true
      short: "Unix timestamp"
      type: "`$INTEGER`"
    }
    {
      name: "tn_h"
      req: false
      short: "Thumbnail height"
