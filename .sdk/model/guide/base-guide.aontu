# Generated from the API definition and overwritten on every build: do not
# edit this file. Put customizations in the guide entry file, which includes
# this one and overrides its defaults:
#   guide.aontu

guide: {
  metrics: count: entity: 6
  metrics: count: path: 6
  metrics: count: method: 6

  entity: archive: {
    path: "/{board}/archive.json": {
      op: list: method: *GET
    }
  }

  entity: board: {
    path: "/boards.json": {
      op: list: method: *GET
      op: list: transform: res: *("`body.boards`")|top
    }
  }

  entity: catalog: {
    path: "/{board}/catalog.json": {
      op: list: method: *GET
    }
  }

  entity: index: {
    path: "/{board}/{page}.json": {
      op: list: method: *GET
      op: list: transform: res: *("`body.threads`")|top
    }
  }

  entity: thread: {
    path: "/{board}/threads.json": {
      op: list: method: *GET
    }
  }

  entity: thread_id: {
    path: "/{board}/thread/{threadId}.json": {
      op: list: method: *GET
      op: list: transform: res: *("`body.posts`")|top
    }
  }

}