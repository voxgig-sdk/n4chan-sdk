# Guide

guide: {
  metrics: count: entity: 5
  metrics: count: path: 6
  metrics: count: method: 6

  entity: archive: {
    path: "/{board}/archive.json": {
      op: list: method: *GET
    }
  }

  entity: board: {
    path: "/boards.json": {
      op: list: method: *GET
    }
  }

  entity: catalog: {
    path: "/{board}/catalog.json": {
      op: list: method: *GET
    }
  }

  entity: index: {
    path: "/{board}/{page}.json": {
      op: list: method: *GET
    }
  }

  entity: thread: {
    path: "/{board}/thread/{threadId}.json": {
      action: "thread_id": {}
      op: list: method: *GET
    }
    path: "/{board}/threads.json": {
      op: list: method: *GET
    }
  }

}