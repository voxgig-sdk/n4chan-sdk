  "name": "n4chan",
  "origin": "voxgig-sdk",
  "def": "4chan_0.1.0.json",
  "main": {
    "kit": {
      "info": {
        "contact": {
          "email": "api@4chan.org"
        },
        "description": "4chan's read-only JSON API for accessing posts, threads, boards, catalogs, and archives from 4chan.org and 4channel.org. Data is exclusively accessible from a.4cdn.org via HTTP or HTTPS protocols.",
        "servers": [
          {
            "description": "4chan API Server (HTTPS)",
            "url": "https://a.4cdn.org"
          },
          {
            "description": "4chan API Server (HTTP)",
            "url": "http://a.4cdn.org"
          }
        ],
        "termsOfService": "https://github.com/4chan/4chan-API#api-terms-of-service",
        "title": "4chan API",
        "version": "1.0.0",
        "x-apisguru-categories": [
          "social"
        ],
        "x-origin": [
          {
            "format": "openapi",
            "url": "https://github.com/4chan/4chan-API",
            "version": "3.0.3"
          }
        ],
        "tagline": "Read-only JSON access to 4chan boards, threads, catalogs, and archives",
        "homepage": "https://a.4cdn.org",
        "docs_url": "https://github.com/4chan/4chan-API",
        "license_short": "Public read-only API with usage rules; attribution to 4chan required, no use of \"4chan\" in app titles",
        "license_md": "- No authentication required; the API is publicly accessible and read-only.\n- Applications must disclose 4chan as the data source and link back to it.\n- The name \"4chan\" may not be used in application titles or branding, and apps must not claim official status.\n- Do not exceed one request per second; thread polling should use a 10-second minimum interval and respect the `If-Modified-Since` header.",
        "about_md": "The [4chan JSON API](https://github.com/4chan/4chan-API) is a public, read-only interface to posts, threads, and boards on [4chan.org](https://www.4chan.org) and 4channel.org, served from `https://a.4cdn.org`. It was launched in September 2012 and is maintained by 4chan.\n\nWhat you get from the API:\n\n- Board listings and per-board metadata via `/boards.json`\n- Catalog views of a board's active threads via `/{board}/catalog.json`\n- Full thread contents (OP plus replies) via `/{board}/thread/{threadid}.json`\n- Board index pages and thread lists via `/{board}/threads.json`\n- Archived (closed) thread IDs via `/{board}/archive.json`\n- Static media paths for spoilers, country flags, capcodes, and user-uploaded files\n\nThe service is anonymous (no API key), supports both HTTP and HTTPS, and enables CORS for `boards.4chan.org` and `boards.4channel.org` origins. Clients are expected to keep within one request per second and use conditional requests when polling.",
        "entity_desc": {
          "archive": "List of archived (closed) thread IDs for a board, served from `/{board}/archive.json`.",
          "board": "Catalogue of all boards with their attributes and configuration, served from `/boards.json`.",
          "catalog": "Native catalog representation of a board's active threads grouped by page, served from `/{board}/catalog.json`.",
          "index": "Board index/main page listing threads with their preview posts, served from `/{board}/{page}.json`.",
          "thread": "Full contents of a single thread (OP plus all replies), served from `/{board}/thread/{threadid}.json`; bulk thread metadata is at `/{board}/threads.json`."
        },
        "auth": false
      },
      "config": {
        "auth": {
          "prefix": "Bearer"
        },
        "headers": {
          "content-type": "application/json"
        },
        "docs_order": [
          "ts",
          "py",
          "php",
          "go",
          "rb",
          "lua"
        ]
      },
